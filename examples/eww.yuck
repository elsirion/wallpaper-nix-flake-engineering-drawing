;; Live system stats rendered into the wallpaper's title block ("SYSTEM" field).
;; Geometry comes from the wallpaper's <name>.field.json sidecar (flake_drawing.py --field), see start.sh.
(defpoll st :interval "10s" :initial '{"cpu":0,"temp":0,"load":"","memu":0,"memt":0,"gtt":0,"disk":"","up":"","vpn":"","ip":"","claude":0,"codex":0,"ff":0,"host":""}'
  `./stats.sh`)

;; Sizes are for 1 sheet px = 1 logical px; start.sh passes `scale` for wallpapers drawn at another size.
(defwidget row [k v scale]
  (box :class "row" :orientation "h" :space-evenly false :style "min-height: ${22 * scale}px"
    (label :class "k" :text k :xalign 0 :width {round(72 * scale, 0)} :style "font-size: ${13 * scale}px")
    (label :class "v" :text v :xalign 0)))

(defwidget stats [scale]
  (box :class "stats" :orientation "h" :space-evenly true :spacing {round(24 * scale, 0)} :style "font-size: ${17 * scale}px"
    (box :orientation "v" :space-evenly false :spacing {round(2 * scale, 0)}
      (row :scale scale :k "CPU"   :v "${st.cpu}%  ${st.temp}°C  load ${st.load}")
      (row :scale scale :k "MEM"   :v "${st.memu} / ${st.memt} GiB   GTT ${st.gtt} GiB")
      (row :scale scale :k "DISK"  :v "${st.disk}")
      (row :scale scale :k "UP"    :v "${st.up}"))
    (box :orientation "v" :space-evenly false :spacing {round(2 * scale, 0)}
      (row :scale scale :k "NET"   :v "${st.ip}")
      (row :scale scale :k "VPN"   :v "${st.vpn}")
      (row :scale scale :k "AGENTS" :v "claude ×${st.claude}   codex ×${st.codex}")
      (row :scale scale :k "HOST"  :v "${st.host}"))))

;; Opened once per active output by start.sh, which computes where the wallpaper's field lands:
;; `eww open stats --screen <output> --id stats-<output> --arg x=.. --arg y=.. --arg w=.. --arg h=.. --arg scale=..`
(defwindow stats [x y w h scale]
  :stacking "bottom" :exclusive false :focusable false :namespace "eww-stats"
  :geometry (geometry :anchor "bottom right" :x "${x}px" :y "${y}px" :width "${w}px" :height "${h}px")
  (stats :scale scale))
